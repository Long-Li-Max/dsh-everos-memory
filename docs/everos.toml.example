# EverOS 用户配置示例
#
# 用法：复制为 <服务根目录>/everos.toml 后按需修改（脚本 scripts/setup-everos.ps1 会自动复制）。
# EverOS 的配置查找顺序（后者覆盖前者）：
#   1. 程序自带的默认配置
#   2. <服务根目录>/everos.toml（本文件）
#   3. 环境变量 EVEROS_<SECTION>__<KEY>（例如 EVEROS_LLM__API_KEY）
# 未写的项一律使用程序内置默认值，所以这里只列最常改的几段。

[memory]
# 日期分桶与时间戳使用的时区（唯一来源，不读系统 TZ）。
timezone = "Asia/Shanghai"

[api]
# 服务监听地址。默认只监听本机回环；不要改成 0.0.0.0，除非你自己在前面加了鉴权网关。
host = "127.0.0.1"
port = 8000

[llm]
# 提炼记忆用的对话模型（OpenAI 协议）。必须填写 api_key，否则无法提炼。
# 也可以改用环境变量：EVEROS_LLM__API_KEY / EVEROS_LLM__BASE_URL / EVEROS_LLM__MODEL
model = "deepseek-flash"
api_key = "<在这里填你自己的 API Key>"
base_url = "https://api.deepseek.com"

[memorize]
# chat = 只记用户记忆；agent = 用户记忆 + Agent 记忆（配合 DSH 用 agent）。
mode = "agent"

# 可选：语义检索（向量）需要额外的 embedding 服务，默认留空即关闭。
# [embedding]
# model = "Qwen/Qwen3-Embedding-4B"
# api_key = "<embedding 服务的 key>"
# base_url = "https://api.deepinfra.com/v1/openai"
